software =
{
    version = "@DISTRO_VERSION@";
    description = "nextoomio system update image";
    hardware-compatibility: [ "@HW_COMPATIBILITY@" ];
    config-schema-range = "@CONFIG_SCHEMA_RANGE@";
    config-schema-min = "1";
    config-schema-max = "1";

    stable = {
        copy1 = {
            images: (
                {
                    filename = "@BOOT_PKG_A@";
                    device = "/dev/mmcblk0p2";
                    type = "raw";
                    compressed = "zlib";
                    sha256 = "@BOOT_A_SHA256@";
                    size = @BOOT_A_SIZE@;
                    installed-directly = true;
                },
                {
                    filename = "@ROOT_PKG_FILE@";
                    device = "/dev/mmcblk0p5";
                    type = "raw";
                    compressed = "zlib";
                    sha256 = "@ROOT_SHA256@";
                    installed-directly = true;
                }
            );
        };
        copy2 = {
            images: (
                {
                    filename = "@BOOT_PKG_B@";
                    device = "/dev/mmcblk0p3";
                    type = "raw";
                    compressed = "zlib";
                    sha256 = "@BOOT_B_SHA256@";
                    size = @BOOT_B_SIZE@;
                    installed-directly = true;
                },
                {
                    filename = "@ROOT_PKG_FILE@";
                    device = "/dev/mmcblk0p6";
                    type = "raw";
                    compressed = "zlib";
                    sha256 = "@ROOT_SHA256@";
                    installed-directly = true;
                }
            );
        };
    };
}
