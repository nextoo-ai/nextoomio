[Unit]
Description=nextoomio trial boot deadline watchdog (UPD-06, AR-01)
DefaultDependencies=no
RequiresMountsFor=/data
After=data.mount nextoomio-update-init.service
Before=basic.target

[Service]
Type=simple
ExecStart=/usr/bin/nx-sysd update trial-watchdog --deadline 120 --poll-interval 1000
Restart=no

[Install]
WantedBy=basic.target
