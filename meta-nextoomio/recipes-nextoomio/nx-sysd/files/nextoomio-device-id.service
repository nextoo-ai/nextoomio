[Unit]
Description=nextoomio persistent device ID initialization
DefaultDependencies=no
Requires=data.mount
After=data.mount
RequiresMountsFor=/data
Before=basic.target multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nx-sysd init-device-id
RemainAfterExit=yes

[Install]
WantedBy=basic.target
