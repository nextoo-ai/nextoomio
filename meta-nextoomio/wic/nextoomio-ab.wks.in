# Dual A/B + /data partition layout for nextoomio (ARCHITECTURE.md section 3.6)
#
# Partition table (MBR, logical partitions 5–7):
#   1: select  (FAT, 64 MiB)   - autoboot.txt / tryboot selector
#   2: boot_a  (FAT, 256 MiB)  - Slot A firmware, config.txt, kernel, overlays
#   3: boot_b  (FAT, 256 MiB)  - Slot B firmware, config.txt, kernel, overlays
#   5: root_a  (ext4, 3072 MiB)- Slot A read-only rootfs
#   6: root_b  (ext4, 3072 MiB)- Slot B read-only rootfs (inactive initially)
#   7: data    (ext4, grown)   - /data/config/v<N>, /data/secrets/v<N>, /data/music, /data/update

part /boot/select --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label select --active --align 4096 --fixed-size 64M
part /boot        --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot_a --align 4096 --fixed-size 256M
part              --ondisk mmcblk0 --fstype=vfat --label boot_b --align 4096 --fixed-size 256M
part /            --source rootfs            --ondisk mmcblk0 --fstype=ext4 --label root_a --align 4096 --fixed-size 3072M
part              --ondisk mmcblk0 --fstype=ext4 --label root_b --align 4096 --fixed-size 3072M
part /data        --ondisk mmcblk0 --fstype=ext4 --label data   --align 4096 --fixed-size 1536M

bootloader --ptable msdos
